# INCLUDE THIS FILE IN YOUR .gitignore TO AVOID LEAKING YOUR CREDENTIALS!
# Copy this file to .env and add your actual credentials
# NEVER commit .env file with real secrets!

# =============================================================================
# ALPACA API CREDENTIALS
# =============================================================================
# Get your API keys from: https://alpaca.markets/

# Paper Trading (for testing - ALWAYS START HERE)
ALPACA_PAPER_API_KEY=your_paper_api_key_here
ALPACA_PAPER_SECRET_KEY=your_paper_secret_key_here

# Live Trading (ONLY enable when ready for real money)
ALPACA_LIVE_API_KEY=your_live_api_key_here
ALPACA_LIVE_SECRET_KEY=your_live_secret_key_here

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://finsight:your_password@localhost:5432/finsight_db

# =============================================================================
# OPTIONAL: NOTIFICATION SERVICES
# =============================================================================

# Email notifications (optional)
EMAIL_ENABLED=false
EMAIL_FROM=alerts@yourdomain.com
EMAIL_TO=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Slack notifications (optional)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# SMS notifications via Twilio (optional)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
